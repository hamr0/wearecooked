{
  "manifest_version": 3,
  "name": "wearecooked",
  "version": "1.0.0",
  "description": "Scan cookies, see who tracks you, and clean trackers in one click. Local-only — no data leaves your browser.",
  "permissions": ["cookies"],
  "optional_host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "wearecooked - Cookie Report"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
